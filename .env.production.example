# =====================================================================
# Contoh .env untuk SERVER PRODUKSI MGA Online Shop.
# Salin ke .env di server lalu isi bagian yang bertanda <...>.
# JANGAN commit file .env asli ke git.
# Cek hasilnya dengan: php artisan shop:check
# =====================================================================

APP_NAME="MGA - Media Gudang Acc"
APP_ENV=production
# Buat dengan: php artisan key:generate  (simpan cadangannya di tempat aman!)
APP_KEY=
APP_DEBUG=false
APP_URL=https://<domain-anda>

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- HTTPS & proxy ---
# true bila situs memakai SSL (wajib untuk toko online).
FORCE_HTTPS=true
# Isi bila di belakang Cloudflare/load balancer, contoh: *  atau  10.0.0.1,10.0.0.2
TRUSTED_PROXIES=

# --- Log error ---
# daily = satu file per hari di storage/logs, disimpan LOG_DAILY_DAYS hari.
# Tambahkan ",slack" untuk notifikasi error kritis ke Slack.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
# LOG_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nama_database>
DB_USERNAME=<user_database>
DB_PASSWORD=<password_kuat>

# --- Sesi ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Cache & antrean ---
# "database" aman untuk semua hosting. Di VPS dengan Redis terpasang,
# ganti CACHE_STORE=redis dan QUEUE_CONNECTION=redis agar lebih cepat.
CACHE_STORE=database
CACHE_PREFIX=mga_
QUEUE_CONNECTION=database
# true HANYA di shared hosting tanpa Supervisor (antrean diproses oleh cron).
QUEUE_VIA_SCHEDULER=false

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# --- Email (SMTP) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp.penyedia-email.com>
MAIL_PORT=587
MAIL_USERNAME=<user_smtp>
MAIL_PASSWORD=<password_smtp>
MAIL_FROM_ADDRESS="halo@<domain-anda>"
MAIL_FROM_NAME="${APP_NAME}"

# --- Backup (php artisan shop:backup, jalan otomatis tiap hari) ---
BACKUP_ENABLED=true
# local = storage/app/private/backups. Lebih aman: s3 (isi AWS_* di bawah).
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_INCLUDE_UPLOADS=true
BACKUP_KEEP_DAYS=14
BACKUP_TIME=02:00
# BACKUP_MYSQLDUMP_PATH=/usr/bin/mysqldump

# S3 / penyimpanan kompatibel S3 (mis. Cloudflare R2, IDCloudHost, Biznet)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Batas percobaan per menit ---
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_IP=20
RATE_LIMIT_REGISTER=5
RATE_LIMIT_PASSWORD_RESET=3

# --- Security headers ---
SECURITY_HSTS=true
SECURITY_HSTS_MAX_AGE=31536000
# SECURITY_CSP=

VITE_APP_NAME="${APP_NAME}"

# --- Toko ---
SHOP_ORIGIN_CITY_ID=<id_kota_asal_rajaongkir>
SHOP_WHATSAPP=<62812xxxxxxx>

# Ulasan baru langsung tayang tanpa moderasi admin (default: false)
REVIEWS_AUTO_APPROVE=false
# false = situs tidak diindeks Google (pakai di staging)
SEO_INDEXING=true
# Gambar default Open Graph saat dibagikan ke WhatsApp/sosmed (path di public/ atau URL)
SEO_DEFAULT_IMAGE=

# --- Payment gateway ---
PAYMENT_DRIVER=midtrans
MIDTRANS_SERVER_KEY=<server_key>
MIDTRANS_CLIENT_KEY=<client_key>
# false = sandbox (uji coba), true = transaksi uang asli
MIDTRANS_IS_PRODUCTION=true

# --- Ongkos kirim ---
SHIPPING_DRIVER=rajaongkir
RAJAONGKIR_API_KEY=<api_key>
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_COURIERS=jne:sicepat:jnt:pos:tiki
