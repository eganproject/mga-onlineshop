APP_NAME="MGA - Media Gudang Acc"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Keamanan (lihat .env.production.example untuk nilai produksi) ---
FORCE_HTTPS=false
TRUSTED_PROXIES=
QUEUE_VIA_SCHEDULER=false
BACKUP_DISK=local
BACKUP_KEEP_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mga_onlineshop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="halo@mga.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Toko ---
# ID kecamatan gudang (cari dengan: php artisan ongkir:wilayah)
SHOP_ORIGIN_DISTRICT_ID=
SHOP_WHATSAPP=
SHOP_ADDRESS=

# Ulasan baru langsung tayang tanpa moderasi admin (default: false)
REVIEWS_AUTO_APPROVE=false
# false = situs tidak diindeks Google (pakai di staging)
SEO_INDEXING=true
# Gambar default Open Graph saat dibagikan ke WhatsApp/sosmed (path di public/ atau URL)
# Kosong = images/brand/og-default.png
SEO_DEFAULT_IMAGE=

# --- Payment gateway ---
# Driver & kunci Midtrans, RajaOngkir, dan Firebase juga bisa diatur superadmin
# di Admin > Integrasi (tersimpan terenkripsi). Nilai di sini menjadi cadangan.
# "fake" untuk development lokal, "midtrans" untuk Midtrans Snap
PAYMENT_DRIVER=fake
PAYMENT_EXPIRY_HOURS=24
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false

# --- Ongkos kirim ---
# "fake" untuk development lokal, "rajaongkir" untuk RajaOngkir (Komerce)
SHIPPING_DRIVER=fake
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_COURIERS=jne:sicepat:jnt:pos:tiki
# Lacak resi otomatis tiap 3 jam (memakai kuota API RajaOngkir) dan auto-selesai pesanan.
TRACKING_SYNC=false
ORDER_AUTO_COMPLETE_DAYS=3
ORDER_SHIPPED_AUTO_COMPLETE_DAYS=14

# --- Login pelanggan dengan Google (Firebase Authentication) ---
# Kosongkan untuk menyembunyikan tombol "Lanjutkan dengan Google".
# Nilai diambil dari Firebase Console > Project settings > Your apps (Web app).
# Lihat docs/FIREBASE.md.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
